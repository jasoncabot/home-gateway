# Set these in the TrueNAS stack's environment, not in git.
CF_API_TOKEN=          # Cloudflare API token, "Edit zone DNS" scoped to your zone
CF_ZONE_ID=            # Cloudflare zone ID
VPN_HOSTNAME=          # DNS name the phone connects to, e.g. vpn.example.com
PIHOLE_IP=             # LAN IP of your Pi-hole
